{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wittymediaserver.com/schemas/wittyinfo-1.json",
  "title": "WittyInfo manifest, version 1",
  "description": "manifest.json of a .wittyinfo: what people add by hand to a film, an episode, a season or a show. See docs/formats/wittyinfo.md. Fields not listed here are allowed: readers keep them and ignore them.",
  "type": "object",
  "required": [
    "format",
    "version"
  ],
  "properties": {
    "format": {
      "const": "wittyinfo"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "scope": {
      "enum": [
        "item",
        "season",
        "show"
      ],
      "default": "item"
    },
    "season": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9999
    },
    "identity": {
      "$ref": "#/$defs/identity"
    },
    "authorship": {
      "$ref": "#/$defs/authorship"
    },
    "segments": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/segment"
      }
    },
    "absent": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/segmentType"
      },
      "uniqueItems": true
    },
    "scenes": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/scene"
      }
    },
    "filters": {
      "type": "array",
      "maxItems": 5000,
      "items": {
        "$ref": "#/$defs/filter"
      }
    },
    "metadata": {
      "$ref": "#/$defs/metadata"
    },
    "artwork": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "poster",
          "backdrop",
          "logo",
          "thumb",
          "banner",
          "clearart",
          "disc",
          "square"
        ]
      },
      "additionalProperties": {
        "$ref": "#/$defs/imageMember"
      }
    },
    "playback": {
      "$ref": "#/$defs/playback"
    },
    "subtitles": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/subtitle"
      }
    },
    "notes": {
      "$ref": "#/$defs/longText"
    },
    "extensions": {
      "description": "Anything a tool wants to keep, under a name of its own such as \"mytool.state\". Kept and never used.",
      "type": "object",
      "maxProperties": 100
    },
    "language": {
      "$ref": "#/$defs/languageTag",
      "description": "The language the file's own text is in."
    },
    "translations": {
      "type": "object",
      "maxProperties": 200,
      "propertyNames": {
        "$ref": "#/$defs/languageTag"
      },
      "additionalProperties": {
        "$ref": "#/$defs/translation"
      },
      "description": "The file's text in other languages, by language tag. Parts are named by their ids."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "scope": {
            "const": "season"
          }
        },
        "required": [
          "scope"
        ]
      },
      "then": {
        "required": [
          "season"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "scope": {
            "enum": [
              "season",
              "show"
            ]
          }
        },
        "required": [
          "scope"
        ]
      },
      "then": {
        "properties": {
          "scenes": {
            "maxItems": 0
          },
          "filters": {
            "maxItems": 0
          },
          "identity": false
        }
      }
    }
  ],
  "$defs": {
    "time": {
      "description": "Seconds from the start of the video, or a clock string such as \"1:05\" or \"1:02:03.5\".",
      "oneOf": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 604800
        },
        {
          "type": "string",
          "pattern": "^\\d+(:[0-5]?\\d){0,2}(\\.\\d+)?$"
        }
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,64}$"
    },
    "shortText": {
      "type": "string",
      "maxLength": 200
    },
    "longText": {
      "type": "string",
      "maxLength": 20000
    },
    "list": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "string",
        "maxLength": 200
      }
    },
    "imageMember": {
      "type": "string",
      "pattern": "^images/[A-Za-z0-9_][A-Za-z0-9 ._/-]*\\.(jpg|jpeg|png|webp)$"
    },
    "segmentType": {
      "enum": [
        "intro",
        "recap",
        "credits",
        "preview",
        "postcredits",
        "commercial",
        "custom"
      ]
    },
    "identity": {
      "type": "object",
      "required": [
        "durationSec"
      ],
      "properties": {
        "durationSec": {
          "$ref": "#/$defs/time"
        },
        "toleranceSec": {
          "type": "number",
          "minimum": 0,
          "maximum": 600
        },
        "fileName": {
          "type": "string",
          "maxLength": 255
        },
        "fileSize": {
          "type": "integer",
          "minimum": 0
        },
        "edition": {
          "$ref": "#/$defs/shortText"
        },
        "fingerprint": {
          "type": "object",
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "maxLength": 64
            },
            "value": {
              "type": "string",
              "maxLength": 512
            }
          }
        }
      }
    },
    "authorship": {
      "type": "object",
      "properties": {
        "author": {
          "$ref": "#/$defs/shortText"
        },
        "created": {
          "type": "string",
          "format": "date-time"
        },
        "updated": {
          "type": "string",
          "format": "date-time"
        },
        "tool": {
          "type": "object",
          "required": [
            "name"
          ],
          "properties": {
            "name": {
              "$ref": "#/$defs/shortText"
            },
            "version": {
              "type": "string",
              "maxLength": 64
            }
          }
        },
        "license": {
          "type": "string",
          "maxLength": 64
        },
        "source": {
          "type": "string",
          "maxLength": 2000
        }
      }
    },
    "segment": {
      "type": "object",
      "required": [
        "type",
        "start"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "$ref": "#/$defs/segmentType"
        },
        "start": {
          "$ref": "#/$defs/time"
        },
        "end": {
          "$ref": "#/$defs/time",
          "description": "Left out: runs to the end of the video."
        },
        "label": {
          "$ref": "#/$defs/shortText"
        },
        "action": {
          "enum": [
            "button",
            "auto",
            "mark"
          ],
          "description": "Default: mark for postcredits, button for the rest."
        },
        "note": {
          "type": "string",
          "maxLength": 2000
        }
      }
    },
    "scene": {
      "type": "object",
      "required": [
        "title",
        "start"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "$ref": "#/$defs/shortText"
        },
        "start": {
          "$ref": "#/$defs/time"
        },
        "thumbnailAt": {
          "$ref": "#/$defs/time"
        },
        "image": {
          "$ref": "#/$defs/imageMember"
        },
        "description": {
          "type": "string",
          "maxLength": 2000
        }
      }
    },
    "filter": {
      "type": "object",
      "required": [
        "category",
        "start",
        "end"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "category": {
          "enum": [
            "violence",
            "language",
            "nudity",
            "sex",
            "drugs",
            "frightening",
            "flashing",
            "discrimination",
            "other"
          ]
        },
        "severity": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "start": {
          "$ref": "#/$defs/time"
        },
        "end": {
          "$ref": "#/$defs/time"
        },
        "action": {
          "enum": [
            "skip",
            "mute",
            "warn"
          ]
        },
        "label": {
          "$ref": "#/$defs/shortText"
        }
      }
    },
    "metadata": {
      "type": "object",
      "properties": {
        "title": {
          "$ref": "#/$defs/shortText"
        },
        "originalTitle": {
          "$ref": "#/$defs/shortText"
        },
        "sortTitle": {
          "$ref": "#/$defs/shortText"
        },
        "edition": {
          "$ref": "#/$defs/shortText"
        },
        "year": {
          "type": "integer",
          "minimum": 1800,
          "maximum": 3000
        },
        "releaseDate": {
          "type": "string",
          "format": "date"
        },
        "overview": {
          "$ref": "#/$defs/longText"
        },
        "tagline": {
          "$ref": "#/$defs/shortText"
        },
        "genres": {
          "$ref": "#/$defs/list"
        },
        "tags": {
          "$ref": "#/$defs/list"
        },
        "contentRating": {
          "$ref": "#/$defs/shortText"
        },
        "studios": {
          "$ref": "#/$defs/list"
        },
        "countries": {
          "$ref": "#/$defs/list"
        },
        "languages": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/languageTag"
          }
        },
        "collection": {
          "$ref": "#/$defs/shortText"
        },
        "episodeKind": {
          "enum": [
            "canon",
            "filler",
            "mixed",
            "recap"
          ]
        },
        "externalIds": {
          "type": "object",
          "maxProperties": 50,
          "propertyNames": {
            "pattern": "^[A-Za-z0-9_.:-]{1,64}$"
          },
          "additionalProperties": {
            "type": "string",
            "maxLength": 128
          }
        },
        "trivia": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "string",
            "maxLength": 2000
          }
        }
      }
    },
    "playback": {
      "type": "object",
      "properties": {
        "startAt": {
          "$ref": "#/$defs/time"
        },
        "audioLanguage": {
          "$ref": "#/$defs/languageTag"
        },
        "subtitleLanguage": {
          "$ref": "#/$defs/languageTag"
        },
        "subtitleMode": {
          "enum": [
            "off",
            "forced",
            "always"
          ]
        },
        "volumeDb": {
          "type": "number",
          "minimum": -30,
          "maximum": 30
        },
        "aspectRatio": {
          "type": "string",
          "pattern": "^\\d{1,2}(\\.\\d{1,3})?:\\d{1,2}(\\.\\d{1,3})?$"
        }
      }
    },
    "subtitle": {
      "type": "object",
      "required": [
        "file"
      ],
      "properties": {
        "file": {
          "type": "string",
          "pattern": "^subtitles/[A-Za-z0-9_][A-Za-z0-9 ._/-]*\\.(srt|vtt|ass|ssa)$"
        },
        "language": {
          "$ref": "#/$defs/languageTag"
        },
        "title": {
          "$ref": "#/$defs/shortText"
        },
        "forced": {
          "type": "boolean"
        },
        "sdh": {
          "type": "boolean"
        }
      }
    },
    "languageTag": {
      "type": "string",
      "maxLength": 35,
      "pattern": "^[A-Za-z]{2,8}([-_][A-Za-z0-9]{1,8})*$",
      "description": "A language: ISO 639-1, 639-2 or 639-3 code, or a BCP 47 tag (en, deu, pt-BR, zh-Hant)."
    },
    "textPart": {
      "type": "object",
      "properties": {
        "label": {
          "$ref": "#/$defs/shortText"
        },
        "title": {
          "$ref": "#/$defs/shortText"
        },
        "note": {
          "type": "string",
          "maxLength": 2000
        },
        "description": {
          "type": "string",
          "maxLength": 2000
        }
      }
    },
    "translation": {
      "type": "object",
      "properties": {
        "segments": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/id"
          },
          "additionalProperties": {
            "$ref": "#/$defs/textPart"
          }
        },
        "scenes": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/id"
          },
          "additionalProperties": {
            "$ref": "#/$defs/textPart"
          }
        },
        "filters": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/id"
          },
          "additionalProperties": {
            "$ref": "#/$defs/textPart"
          }
        },
        "metadata": {
          "$ref": "#/$defs/metadata"
        },
        "notes": {
          "$ref": "#/$defs/longText"
        }
      }
    }
  }
}
