{
  "$defs": {
    "Action": {
      "description": "What activating a node does. \"$name\" in target stands for the activated node's prop of that name.",
      "properties": {
        "params": {
          "type": "object"
        },
        "target": {
          "type": "string"
        },
        "type": {
          "description": "Known: see x-knownTypes. Ignore a node's action when its type is unknown.",
          "type": "string",
          "x-knownTypes": [
            "navigate",
            "play",
            "openModal",
            "closeModal",
            "fetch",
            "toggle",
            "submit",
            "external",
            "back"
          ]
        }
      },
      "required": [
        "type"
      ],
      "type": "object"
    },
    "Diff": {
      "description": "The answer of /diff: patches, or the whole document when the server no longer has the render named by since.",
      "properties": {
        "document": {
          "$ref": "#/$defs/Document"
        },
        "etag": {
          "type": "string"
        },
        "patches": {
          "items": {
            "$ref": "#/$defs/Patch"
          },
          "type": "array"
        },
        "since": {
          "type": "string"
        }
      },
      "required": [
        "etag"
      ],
      "type": "object"
    },
    "Document": {
      "description": "One rendered screen.",
      "properties": {
        "actions": {
          "additionalProperties": {
            "$ref": "#/$defs/Action"
          },
          "type": "object"
        },
        "layout": {
          "$ref": "#/$defs/Layout"
        },
        "meta": {
          "description": "About the document.",
          "properties": {
            "description": {
              "type": "string"
            },
            "etag": {
              "type": "string"
            },
            "generatedAt": {
              "format": "date-time",
              "type": "string"
            },
            "source": {
              "type": "string"
            },
            "title": {
              "type": "string"
            },
            "ttlSeconds": {
              "type": "integer"
            }
          },
          "type": "object"
        },
        "root": {
          "$ref": "#/$defs/Node"
        },
        "screen": {
          "type": "string"
        },
        "theme": {
          "description": "The theme, and colours for parts that belong to a module.",
          "properties": {
            "id": {
              "type": "string"
            },
            "moduleOverrides": {
              "additionalProperties": {
                "additionalProperties": {
                  "type": "string"
                },
                "type": "object"
              },
              "type": "object"
            }
          },
          "required": [
            "id"
          ],
          "type": "object"
        },
        "version": {
          "const": 1,
          "type": "integer"
        }
      },
      "required": [
        "version",
        "screen",
        "root"
      ],
      "type": "object"
    },
    "Focus": {
      "description": "The node's place in the focus engine.",
      "properties": {
        "default": {
          "type": "boolean"
        },
        "down": {
          "type": "string"
        },
        "focusable": {
          "type": "boolean"
        },
        "group": {
          "type": "string"
        },
        "left": {
          "type": "string"
        },
        "order": {
          "minimum": 1,
          "type": "integer"
        },
        "right": {
          "type": "string"
        },
        "up": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "ImageRef": {
      "description": "A picture and the size to show it at, in pixels.",
      "properties": {
        "aspect": {
          "type": "string"
        },
        "height": {
          "type": "integer"
        },
        "url": {
          "type": "string"
        },
        "width": {
          "type": "integer"
        }
      },
      "required": [
        "url",
        "width",
        "height",
        "aspect"
      ],
      "type": "object"
    },
    "Layout": {
      "description": "The device profile the screen was fitted to.",
      "properties": {
        "canvas": {
          "description": "The screen in points.",
          "properties": {
            "height": {
              "type": "integer"
            },
            "width": {
              "type": "integer"
            }
          },
          "type": "object"
        },
        "class": {
          "type": "string"
        },
        "externalLinks": {
          "type": "boolean"
        },
        "focusEngine": {
          "type": "boolean"
        },
        "formFactor": {
          "type": "string",
          "x-knownValues": [
            "tv",
            "phone",
            "tablet",
            "desktop",
            "web"
          ]
        },
        "gridColumns": {
          "type": "integer"
        },
        "images": {
          "additionalProperties": {
            "description": "A picture size in pixels.",
            "properties": {
              "aspect": {
                "type": "string"
              },
              "height": {
                "type": "integer"
              },
              "width": {
                "type": "integer"
              }
            },
            "required": [
              "width",
              "height",
              "aspect"
            ],
            "type": "object"
          },
          "type": "object"
        },
        "maxGridItems": {
          "type": "integer"
        },
        "maxItems": {
          "type": "integer"
        },
        "maxSections": {
          "type": "integer"
        },
        "safeArea": {
          "description": "Distances from each edge, in points.",
          "properties": {
            "bottom": {
              "type": "integer"
            },
            "left": {
              "type": "integer"
            },
            "right": {
              "type": "integer"
            },
            "top": {
              "type": "integer"
            }
          },
          "type": "object"
        },
        "scale": {
          "type": "integer"
        },
        "scroll": {
          "type": "string"
        },
        "text": {
          "additionalProperties": {
            "type": "integer"
          },
          "type": "object"
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "required": [
        "formFactor",
        "scale",
        "safeArea",
        "scroll",
        "focusEngine",
        "maxSections",
        "maxItems",
        "maxGridItems",
        "externalLinks"
      ],
      "type": "object"
    },
    "Node": {
      "description": "One component. Draw an unknown type as a plain container of its children.",
      "properties": {
        "action": {
          "description": "A key of the document's actions.",
          "type": "string"
        },
        "children": {
          "items": {
            "$ref": "#/$defs/Node"
          },
          "type": "array"
        },
        "focus": {
          "$ref": "#/$defs/Focus"
        },
        "id": {
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "type": "string"
        },
        "props": {
          "type": "object"
        },
        "style": {
          "$ref": "#/$defs/Style"
        },
        "type": {
          "description": "A component type. Known in this revision: see x-knownTypes. Others must be drawn as a plain container.",
          "type": "string",
          "x-knownTypes": [
            "Screen",
            "Stack",
            "Grid",
            "Shelf",
            "HeroBanner",
            "Card",
            "PosterRow",
            "Text",
            "Image",
            "Button",
            "Tabs",
            "Tab",
            "List",
            "ListItem",
            "Spacer",
            "Divider",
            "Video",
            "Badge",
            "ProgressBar",
            "Carousel",
            "SearchBar",
            "Toolbar",
            "Modal"
          ]
        }
      },
      "required": [
        "type",
        "id"
      ],
      "type": "object"
    },
    "Patch": {
      "description": "One step from the screen a client has to the current one.",
      "properties": {
        "from": {
          "type": "string"
        },
        "node": {
          "$ref": "#/$defs/Node"
        },
        "op": {
          "enum": [
            "add",
            "remove",
            "replace",
            "move"
          ]
        },
        "path": {
          "type": "string"
        },
        "value": {}
      },
      "required": [
        "op",
        "path"
      ],
      "type": "object"
    },
    "Style": {
      "description": "Layout and colour hints. Colours are #hex, rgb()/hsl(), or token:<name>.",
      "properties": {
        "accent": {
          "type": "string"
        },
        "align": {
          "type": "string"
        },
        "aspectRatio": {
          "type": "string"
        },
        "background": {
          "type": "string"
        },
        "border": {
          "type": "string"
        },
        "class": {
          "type": "string"
        },
        "columns": {
          "type": "integer"
        },
        "direction": {
          "enum": [
            "row",
            "column"
          ]
        },
        "elevation": {
          "type": "integer"
        },
        "foreground": {
          "type": "string"
        },
        "gap": {
          "type": "integer"
        },
        "height": {
          "type": "string"
        },
        "hidden": {
          "type": "boolean"
        },
        "justify": {
          "type": "string"
        },
        "margin": {
          "type": "string"
        },
        "module": {
          "type": "string"
        },
        "opacity": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "padding": {
          "type": "string"
        },
        "radius": {
          "type": "integer"
        },
        "tokens": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "width": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "TopShelf": {
      "description": "Content for a tvOS Top Shelf extension.",
      "properties": {
        "expiresInSec": {
          "type": "integer"
        },
        "sections": {
          "items": {
            "description": "One titled row.",
            "properties": {
              "items": {
                "items": {
                  "description": "One picture.",
                  "properties": {
                    "displayRoute": {
                      "type": "string"
                    },
                    "id": {
                      "type": "string"
                    },
                    "image": {
                      "$ref": "#/$defs/ImageRef"
                    },
                    "playRoute": {
                      "type": "string"
                    },
                    "progress": {
                      "type": "number"
                    },
                    "shape": {
                      "enum": [
                        "poster",
                        "wide",
                        "square"
                      ]
                    },
                    "title": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "id",
                    "title",
                    "shape",
                    "displayRoute"
                  ],
                  "type": "object"
                },
                "maxItems": 10,
                "type": "array"
              },
              "title": {
                "type": "string"
              }
            },
            "required": [
              "title",
              "items"
            ],
            "type": "object"
          },
          "maxItems": 4,
          "type": "array"
        },
        "style": {
          "const": "sectioned"
        },
        "version": {
          "type": "integer"
        }
      },
      "required": [
        "version",
        "style",
        "sections",
        "expiresInSec"
      ],
      "type": "object"
    }
  },
  "$id": "urn:wittymediaserver:sdui:schema:1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "What GET /api/v1/sdui/screens/{screen}, its /diff and /api/v1/sdui/topshelf answer. Unknown properties must be ignored, and an unknown node type drawn as a plain container of its children.",
  "oneOf": [
    {
      "$ref": "#/$defs/Document"
    },
    {
      "$ref": "#/$defs/Diff"
    },
    {
      "$ref": "#/$defs/TopShelf"
    }
  ],
  "title": "WittyMediaServer server-driven UI, schema version 1",
  "x-catalogRevision": 1,
