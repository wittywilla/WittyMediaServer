go 1.26.0

toolchain go1.27.3

use (
	.
	./modules/wittybluray
	./modules/wittycd
	./modules/wittydisc
	./modules/wittydvd
	./modules/wittyintegratedfilebrowser
	./modules/wittymodule
	./modules/wittyphotos
	./modules/wittytuner
	./modules/wittyplay
	./apps/wittymediaplayer/engine
	./modules/wittydvd/wittydvdplayer
	./modules/wittybluray/wittyblurayplayer
)

// The player's modules aren't published yet.
replace (
	github.com/wittywilla/wittycd v0.1.0 => ./modules/wittycd
	github.com/wittywilla/wittybluray/wittyblurayplayer v0.1.0 => ./modules/wittybluray/wittyblurayplayer
	github.com/wittywilla/wittydvd/wittydvdplayer v0.1.0 => ./modules/wittydvd/wittydvdplayer
)
