    "player": {
      "version": 1,
      "screen": "player",
      "theme": {
        "id": "default"
      },
      "root": {
        "type": "Screen",
        "id": "player",
        "props": {
          "scroll": false,
          "title": "Now playing"
        },
        "style": {
          "background": "#000000",
          "foreground": "token:onImage",
          "class": "player"
        },
        "children": [
          {
            "type": "Video",
            "id": "player-video",
            "props": {
              "autoplay": true,
