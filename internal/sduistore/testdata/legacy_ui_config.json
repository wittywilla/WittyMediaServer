{
  "revision": 3,
  "screens": {
    "detail": {
      "version": 1,
      "screen": "detail",
      "theme": {
        "id": "default"
      },
      "root": {
        "type": "Screen",
        "id": "detail",
        "props": {
          "scroll": true,
          "title": "Details"
        },
        "style": {
          "direction": "column",
          "gap": 24
        },
        "children": [
          {
            "type": "HeroBanner",
            "id": "detail-hero",
            "props": {
              "title": "Details"
            },
            "style": {
              "aspectRatio": "16/9",
              "class": "detail-hero"
            },
            "children": [
              {
                "type": "Stack",
                "id": "detail-meta",
                "style": {
                  "direction": "row",
                  "gap": 12,
                  "align": "center"
                },
                "children": [
                  {
                    "type": "Badge",
                    "id": "detail-year",
                    "props": {
                      "text": "0"
                    },
                    "visibility": {
                      "not": {
                        "flag": "hideYear"
                      }
                    },
                    "bindings": {
                      "text": {
                        "path": "$.item.year",
                        "default": ""
                      }
                    }
                  },
                  {
                    "type": "Badge",
                    "id": "detail-duration",
                    "props": {
                      "text": ""
                    },
                    "bindings": {
                      "text": {
                        "path": "$.item.duration",
                        "default": 0,
                        "format": "duration"
                      }
                    }
                  },
                  {
                    "type": "Badge",
                    "id": "detail-rating",
                    "props": {
                      "text": "NR"
                    },
                    "bindings": {
                      "text": {
                        "path": "$.item.rating",
                        "default": "NR"
                      }
                    }
                  }
                ]
              },
              {
                "type": "Stack",
                "id": "detail-actions",
                "style": {
                  "direction": "row",
                  "gap": 12
                },
                "children": [
                  {
                    "type": "Button",
                    "id": "detail-play",
                    "props": {
                      "icon": "play",
                      "label": "Play",
                      "variant": "primary"
                    },
                    "visibility": {
                      "all": [
                        {
                          "feature": "playback"
                        },
                        {
                          "not": {
                            "flag": "notPlayable"
                          }
                        }
                      ]
                    },
                    "bindings": {
                      "itemId": {
                        "path": "$.item.playId"
                      }
                    },
                    "action": "playItem"
                  },
                  {
                    "type": "Button",
                    "id": "detail-resume",
                    "props": {
                      "icon": "resume",
                      "label": "Resume"
                    },
                    "visibility": {
                      "all": [
                        {
                          "feature": "playback"
                        },
                        {
                          "flag": "hasProgress"
                        }
                      ]
                    },
                    "bindings": {
                      "itemId": {
                        "path": "$.item.playId"
                      }
                    },
                    "action": "resume"
                  },
                  {
                    "type": "Button",
                    "id": "detail-artwork",
                    "props": {
                      "label": "Artwork",
                      "variant": "ghost"
                    },
                    "visibility": {
                      "role": "admin"
                    },
                    "action": "openArtwork"
                  }
                ]
              },
              {
                "type": "ProgressBar",
                "id": "detail-progress",
                "props": {
                  "value": 0
                },
                "visibility": {
                  "flag": "hasProgress"
                },
                "bindings": {
                  "value": {
                    "path": "$.item.progress"
                  }
                }
              }
            ],
            "bindings": {
              "backdropUrl": {
                "path": "$.item.backdrop",
                "default": ""
              },
              "subtitle": {
                "path": "$.item.subtitle",
                "default": ""
              },
              "title": {
                "path": "$.item.title"
              }
            }
          },
          {
            "type": "Text",
            "id": "detail-overview",
            "props": {
              "maxLines": 6,
              "text": "",
              "variant": "body"
            },
            "bindings": {
              "text": {
                "path": "$.item.overview",
                "default": "No overview yet."
              }
            }
          },
          {
            "type": "List",
            "id": "detail-children",
            "bindings": {
              "items": {
                "path": "$.item.children"
              }
            }
          },
          {
            "type": "PosterRow",
            "id": "detail-related",
            "props": {
              "title": "More like this"
            },
            "visibility": {
              "feature": "recommendations"
            },
            "bindings": {
              "items": {
                "path": "$.item.related"
              }
            }
          },
          {
            "type": "Modal",
            "id": "detail-artwork-modal",
            "props": {
              "dismissible": true,
              "title": "Artwork"
            },
            "children": [
              {
                "type": "Text",
                "id": "detail-artwork-hint",
                "props": {
                  "text": "Choose a poster or backdrop for this title."
                }
              },
              {
                "type": "Button",
                "id": "detail-artwork-close",
                "props": {
                  "label": "Close"
                },
                "action": "closeModal"
              }
            ],
            "visibility": {
              "role": "admin"
            }
          }
        ],
        "bindings": {
          "title": {
            "path": "$.item.title"
          }
        }
      },
      "actions": {
        "back": {
          "type": "back"
        },
        "closeModal": {
          "type": "closeModal"
        },
        "goHome": {
          "type": "navigate",
          "target": "/"
        },
        "goLibrary": {
          "type": "navigate",
          "target": "/library"
        },
        "goSearch": {
          "type": "navigate",
          "target": "/search"
        },
        "goSettings": {
          "type": "navigate",
          "target": "/settings"
        },
        "openArtwork": {
          "type": "openModal",
          "target": "detail-artwork-modal"
        },
        "openItem": {
          "type": "navigate",
          "target": "$route"
        },
        "playItem": {
          "type": "play",
          "target": "$itemId"
        },
        "resume": {
          "type": "play",
          "target": "$itemId",
          "params": {
            "resume": true
          }
        }
      },
      "meta": {
        "title": "Details",
        "source": "template:detail",
        "ttlSeconds": 120
      }
    },
    "home": {
      "version": 1,
      "screen": "home",
      "theme": {
        "id": "default"
      },
      "root": {
        "type": "Screen",
        "id": "home",
        "props": {
          "scroll": true,
          "title": "Home"
        },
        "style": {
          "direction": "column",
          "gap": 32,
          "background": "token:bg"
        },
        "children": [
          {
            "type": "Toolbar",
            "id": "home-toolbar",
