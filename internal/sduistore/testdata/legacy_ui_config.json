              {
                "type": "Text",
                "id": "home-greeting",
                "props": {
                  "text": "Welcome back",
                  "variant": "pageTitle"
                },
                "bindings": {
                  "text": {
                    "path": "$.user.name",
                    "default": "Welcome back",
                    "format": "title"
                  }
