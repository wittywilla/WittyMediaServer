            "props": {
              "cardShape": "wide",
              "title": "Next up"
            },
            "bindings": {
              "items": {
                "path": "$.home.nextUp"
              }
            }
          },
          {
            "type": "PosterRow",
            "id": "home-recent",
            "props": {
              "title": "Recently added"
            },
            "bindings": {
              "items": {
                "path": "$.home.recentlyAdded"
              }
            }
          },
          {
            "type": "Stack",
            "id": "home-libraries",
            "style": {
              "direction": "column"
            },
            "bindings": {
              "sections": {
                "path": "$.home.sections"
              }
            }
          },
          {
            "type": "PosterRow",
            "id": "home-recommended",
            "props": {
              "title": "Recommended for you"
            },
            "visibility": {
              "feature": "recommendations"
            },
            "bindings": {
              "items": {
                "path": "$.home.recommended"
              }
            }
          },
          {
            "type": "Shelf",
            "id": "home-games",
            "props": {
              "cardShape": "square",
              "title": "Jump back into a game"
            },
            "style": {
              "module": "wittyplay"
            },
            "visibility": {
              "module": "wittyplay"
            },
            "bindings": {
              "items": {
                "path": "$.home.games"
              }
            }
          },
          {
            "type": "Shelf",
            "id": "home-livetv",
            "props": {
              "cardShape": "wide",
              "title": "Channels"
            },
            "style": {
              "module": "wittytv"
            },
            "bindings": {
              "items": {
                "path": "$.home.channels"
              }
            }
          },
          {
            "type": "Shelf",
            "id": "home-music",
            "props": {
              "cardShape": "square",
              "title": "Recently added music"
            },
            "style": {
              "module": "wittymusic"
            },
            "bindings": {
              "items": {
                "path": "$.home.music"
              }
            }
          },
          {
            "type": "Button",
            "id": "home-admin-setup",
            "props": {
              "label": "Finish server setup",
              "variant": "primary"
            },
            "visibility": {
              "all": [
                {
                  "role": "admin"
                },
                {
                  "flag": "setupIncomplete"
                }
              ]
            },
            "action": "goSettings"
          }
        ]
      },
      "actions": {
        "back": {
