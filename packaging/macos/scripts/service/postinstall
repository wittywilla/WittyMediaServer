#!/bin/sh
# The background service: launchd starts the server at boot, as the person who installed it, so it
# sees their media and their library. The app's menu-bar icon then shows the service.
set -e
PLIST=/Library/LaunchDaemons/com.wittywilla.wittymediaserver.plist

# Keep whatever an earlier install chose. Its port, from before 0.7.0, moves into settings.ini below;
# an address with a host in front stays as WMS_LISTEN.
DATA=""
PORT=""
LISTEN=""
if [ -f "$PLIST" ]; then
  DATA=$(/usr/libexec/PlistBuddy -c 'Print :EnvironmentVariables:WMS_DATA_DIR' "$PLIST" 2>/dev/null || true)
  LISTEN=$(/usr/libexec/PlistBuddy -c 'Print :EnvironmentVariables:WMS_LISTEN' "$PLIST" 2>/dev/null || true)
  case "$LISTEN" in
    :[0-9]*|0.0.0.0:[0-9]*) [ "${LISTEN##*:}" != 9797 ] && PORT="${LISTEN##*:}" ;;
  esac
  launchctl bootout system "$PLIST" 2>/dev/null || true
fi

RUN_AS=$(stat -f %Su /dev/console)
if [ -z "$RUN_AS" ] || [ "$RUN_AS" = root ] || [ "$RUN_AS" = loginwindow ]; then
  # Installed with nobody at the screen, by management software: the first real account.
  RUN_AS=$(dscl . -list /Users UniqueID | awk '$2 >= 501 { print $1; exit }')
fi
HOME_DIR=$(dscl . -read "/Users/$RUN_AS" NFSHomeDirectory | awk '{print $2}')

if [ -z "$DATA" ]; then
  if [ -f /var/lib/wittymediaserver/wms.db ]; then
    DATA=/var/lib/wittymediaserver # the install.sh of 0.5.2-alpha or older
  else
    DATA="$HOME_DIR/Library/Application Support/WittyMediaServer"
  fi
fi
# As root, on a place the person it's for can write to: a link there would hand them what it points at.
if [ -L "$DATA" ]; then
  echo "$DATA is a link. Remove it, or choose a real folder, and install again." >&2
  exit 1
fi
mkdir -p "$DATA"
chown -h "$RUN_AS" "$DATA"
chmod -h 700 "$DATA"
# The port is in settings.ini now, where Settings → Network changes it. Written as the person it's
# for, so nothing they put in their folder is read or changed as root.
if [ -n "$PORT" ]; then
  sudo -u "$RUN_AS" /Applications/WittyMediaServer.app/Contents/Helpers/wittymediaserver config port -data "$DATA" -in-data -port "$PORT" || true
fi

# What goes in a property list as text.
xml() { printf '%s' "$1" | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g'; }

cat > "$PLIST" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.wittywilla.wittymediaserver</string>
  <key>ProgramArguments</key><array>
    <string>/Applications/WittyMediaServer.app/Contents/Helpers/wittymediaserver</string>
    <string>serve</string>
  </array>
  <key>EnvironmentVariables</key><dict>
    <key>WMS_DATA_DIR</key><string>$(xml "$DATA")</string>
    <key>WMS_NO_BROWSER</key><string>1</string>
    <key>WMS_SUPERVISED</key><string>1</string>$(case "$LISTEN" in ""|:[0-9]*|0.0.0.0:[0-9]*) ;; *) printf '\n    <key>WMS_LISTEN</key><string>%s</string>' "$(xml "$LISTEN")" ;; esac)
  </dict>
  <key>UserName</key><string>$(xml "$RUN_AS")</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ProcessType</key><string>Background</string>
</dict></plist>
EOF
chown root:wheel "$PLIST"
chmod 644 "$PLIST"
launchctl bootstrap system "$PLIST"
exit 0
