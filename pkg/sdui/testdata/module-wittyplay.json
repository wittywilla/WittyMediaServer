          "source": {
            "limit": 60,
            "only": "all",
            "type": "wittyplay.consoles"
          }
        }
      ]
    },
    {
      "id": "wittyplay-online",
      "kind": "custom",
      "title": "WittyPlay Online",
      "icon": "game",
      "description": "WittyPlay Online: recent games, classics by era, friends and rooms, memories.",
      "scope": "wittyplay",
      "sections": [
        {
          "id": "tabs",
          "component": "Tabs",
          "props": {
            "default": "recent",
            "style": "tabs"
          },
          "children": [
            {
              "id": "recent",
              "component": "Tab",
              "props": {
                "icon": "history",
                "label": "Recent"
              },
              "children": [
                {
                  "id": "recent-row",
                  "component": "Shelf",
                  "props": {
                    "cardSize": "l",
                    "detail": true,
                    "empty": "message",
                    "emptyText": "Games you play show up here.",
                    "focusGrow": true,
                    "seeAll": "never",
                    "title": ""
                  },
                  "source": {
                    "limit": 20,
                    "type": "wittyplay.recent"
                  }
                }
              ]
            },
            {
              "id": "classics",
              "component": "Tab",
              "props": {
                "icon": "game",
                "label": "Classics"
              },
              "children": [
                {
                  "id": "eras",
                  "component": "Grid",
                  "props": {
                    "title": "Classics by era"
                  },
                  "source": {
                    "type": "wittyplay.collections"
                  }
                }
              ]
            },
            {
              "id": "together",
              "component": "Tab",
              "props": {
                "icon": "users",
                "label": "Together"
              },
              "children": [
                {
                  "id": "lobby",
                  "component": "Split",
                  "props": {
                    "ratio": "1:2",
                    "stackBelow": "expanded"
                  },
                  "children": [
                    {
                      "id": "friends",
                      "component": "List",
                      "props": {
                        "empty": "message",
                        "emptyText": "No friends to show yet.",
                        "focusable": true,
                        "title": "Friends"
                      },
                      "source": {
                        "type": "wittyplay.friends"
                      }
                    },
                    {
                      "id": "rooms-side",
                      "component": "Stack",
                      "props": {
                        "gap": "l"
                      },
                      "children": [
                        {
                          "id": "room",
                          "component": "List",
                          "props": {
                            "focusable": true,
                            "title": "Your room"
                          },
                          "source": {
                            "type": "wittyplay.room"
                          }
                        },
                        {
                          "id": "rooms",
                          "component": "Grid",
                          "props": {
                            "empty": "message",
                            "emptyText": "No friend has a room open.",
                            "focusable": true,
                            "title": "Open rooms"
                          },
                          "source": {
                            "type": "wittyplay.rooms"
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "id": "memories",
              "component": "Tab",
              "props": {
                "icon": "photo",
                "label": "Memories"
              },
              "children": [
                {
                  "id": "memories-grid",
                  "component": "Grid",
                  "props": {
                    "empty": "message",
                    "emptyText": "Save states and screenshots you keep show up here.",
                    "title": "This week"
                  },
                  "source": {
                    "limit": 60,
                    "type": "wittyplay.memories"
                  }
                }
              ]
            },
            {
              "id": "discover",
              "component": "Tab",
              "props": {
                "icon": "sparkles",
                "label": "Discover"
              },
              "children": [
                {
                  "id": "consoles-row",
                  "component": "Shelf",
                  "props": {
                    "title": "What this server plays"
                  },
                  "source": {
                    "limit": 40,
                    "only": "ready",
                    "type": "wittyplay.consoles"
                  }
                }
              ]
            }
          ]
        },
        {
          "id": "dock",
          "component": "Dock",
          "props": {
            "legend": true
          }
        }
