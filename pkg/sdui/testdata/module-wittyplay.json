          "id": "actions",
          "component": "List",
          "props": {
            "title": "{title}"
          },
          "children": [
            {
              "id": "delete",
              "component": "ListItem",
              "props": {
                "confirm": "Delete this memory?",
                "icon": "warning",
                "item": "$item",
                "op": "wittyplay.memory.delete",
                "params": {
                  "name": "$name"
                },
                "title": "Delete this memory"
              }
            }
          ]
        },
        {
          "id": "dock",
          "component": "Dock",
          "props": {
            "legend": true
          }
        }
