    {
      "type": "wittyplay.consoles",
      "label": "Consoles this server plays",
      "description": "Every console, whether its games play on this server, and how: a core, or a standalone emulator.",
      "icon": "game",
      "category": "",
      "params": [
        {
          "name": "only",
          "type": "enum",
          "label": "Which consoles",
          "default": "all",
          "options": [
            {
              "value": "all",
              "label": "Every console"
            },
            {
              "value": "ready",
              "label": "Those that play here"
            }
          ],
          "since": 0
        },
        {
          "name": "limit",
          "type": "int",
          "label": "At most",
          "default": 40,
          "min": 1,
          "max": 60,
          "since": 0
        }
      ],
      "yields": [
        "view"
      ],
      "cardStyle": "tile",
      "paged": false,
